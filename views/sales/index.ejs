<div class="container mt-4">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Ventas</h2>
    <a href="/sales/new" class="btn btn-primary">+ Registrar Venta</a>
  </div>

  <% if (sales.length === 0) { %>
    <div class="alert alert-info">No hay ventas registradas.</div>
  <% } else { %>
    <table class="table table-striped table-hover">
      <thead class="table-dark">
        <tr>
          <th>Libro</th>
          <th>Cantidad</th>
          <th>Año</th>
          <th>Acciones</th>
        </tr>
      </thead>
      <tbody>
        <% sales.forEach(sale => { %>
          <tr>
            <td><a href="/books/<%= sale.BookId %>"><%= sale.Book ? sale.Book.title : 'N/A' %></a></td>
            <td><%= sale.quantity %></td>
            <td><%= sale.year %></td>
            <td>
              <a href="/sales/<%= sale.id %>" class="btn btn-sm btn-info">Ver</a>
              <a href="/sales/<%= sale.id %>/edit" class="btn btn-sm btn-warning">Editar</a>
              <form action="/sales/<%= sale.id %>/delete" method="POST" style="display:inline">
                <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('¿Eliminar esta venta?')">Eliminar</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</div>
