<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
</head>
<body>
    <div class="container">
      <h1>Author Details</h1>
      <p>Name: <%= author.name %></p>
      <p>Bio: <%= author.bio %></p>
      <p>Date of Birth: <%= author.birthday %></p>
      <p>Country of Origin: <%= author.country %></p>
    </div>
    <div class="container">
      <table class="table">
        <thead>
          <tr>
            <th>Title</th>
            <th>Genre</th>
            <th>Summary</th>
            <th>Release Date</th>
          </tr>
        </thead>
        <tbody>
          <% author.Books.forEach(book => { %>
            <tr>
              <td><%= book.title %></td>
              <td><%= book.genre %></td>
              <td><%= book.summary %></td>
              <td><%= book.release_date %></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
</body>
</html>