<div class="container mt-4">
  <h2>Top 50 Libros Más Vendidos</h2>
  
  <table class="table table-striped table-hover mt-3" id="topSalesTable">
    <thead class="table-dark">
      <tr>
        <th>#</th>
        <th>Título del Libro</th>
        <th>Autor</th>
        <th>Año de Publicación</th>
        <th>Ventas Totales del Libro</th>
        <th>Ventas Totales del Autor</th>
        <th>¿Top 5 en Año de Publicación?</th>
      </tr>
    </thead>
    <tbody>
      <% if (books.length === 0) { %>
        <tr>
          <td colspan="7" class="text-center">No hay libros ni ventas registradas.</td>
        </tr>
      <% } else { %>
        <% books.forEach((book, index) => { %>
          <tr>
            <td><strong><%= index + 1 %></strong></td>
            <td><a href="/books/<%= book.id %>"><%= book.title %></a></td>
            <td><%= book.authorName %></td>
            <td><%= book.releaseYear || 'N/A' %></td>
            <td><strong><%= book.totalBookSales.toLocaleString() %></strong></td>
            <td><%= book.totalAuthorSales.toLocaleString() %></td>
            <td>
              <% if (book.isTop5InReleaseYear) { %>
                <span class="badge bg-success fs-6">✓ Sí</span>
              <% } else { %>
                <span class="badge bg-secondary fs-6">No</span>
              <% } %>
            </td>
          </tr>
        <% }) %>
      <% } %>
    </tbody>
  </table>
</div>
