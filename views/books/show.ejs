<div class="container mt-4">
  <div class="card">
    <div class="card-body">
      <h2 class="card-title"><%= book.title %></h2>
      <p><strong>Género:</strong> <%= book.genre || 'N/A' %></p>
      <p><strong>Autor:</strong> <%= book.Author ? book.Author.name : 'N/A' %></p>
      <p><strong>Fecha de lanzamiento:</strong> <%= book.release_date || 'N/A' %></p>
      <p><strong>Resumen:</strong> <%= book.summary || 'Sin resumen' %></p>

      <a href="/books/<%= book.id %>/edit" class="btn btn-warning">Editar</a>
      <a href="/books" class="btn btn-secondary">← Volver</a>
    </div>
  </div>

  <hr>

  <div class="d-flex justify-content-between align-items-center mb-3">
    <h3>Reseñas</h3>
    <a href="/books/<%= book.id %>/reviews/new" class="btn btn-primary btn-sm">+ Agregar Reseña</a>
  </div>

  <% if (reviews.length === 0) { %>
    <div class="alert alert-info">Aún no hay reseñas para este libro.</div>
  <% } else { %>
    <% reviews.forEach(review => { %>
      <div class="card mb-2">
        <div class="card-body">
          <div class="d-flex justify-content-between">
            <strong><%= review.reviewer_name %></strong>
            <span>
              <% for (let i = 0; i < review.rating; i++) { %>⭐<% } %>
              (<%= review.rating %>/5)
            </span>
          </div>
          <p class="mt-2 mb-1"><%= review.comment %></p>
          <div class="d-flex justify-content-between align-items-center">
            <small class="text-muted">👍 <%= review.up_votes %></small>
            <div>
              <a href="/books/<%= book.id %>/reviews/<%= review.id %>/edit" class="btn btn-sm btn-warning">Editar</a>
              <form action="/books/<%= book.id %>/reviews/<%= review.id %>/delete" method="POST" style="display:inline">
                <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('¿Eliminar esta reseña?')">Eliminar</button>
              </form>
            </div>
          </div>
        </div>
      </div>
    <% }) %>
  <% } %>
</div>
