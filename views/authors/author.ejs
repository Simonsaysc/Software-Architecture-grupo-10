<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
</head>
<body>

  <button onclick="location.href='/authors'">Back to Authors List</button>
  
    <div class="container">
      <h1>Author Details</h1>
      <p>Name: <%= author.name %></p>
      <p>Bio: <%= author.bio %></p>
      <p>Date of Birth: <%= author.birthday %></p>
      <p>Country of Origin: <%= author.country %></p>
    </div>

    <button onclick="location.href='/authors/<%= author.id %>/edit'">Edit Author</button>

    <div class="container">
      <h2>Books by <%= author.name %></h2>
      <table class="table">
        <thead>
          <tr>
            <th>Title</th>
            <th>Genre</th>
            <th>Summary</th>
            <th>Release Date</th>
          </tr>
        </thead>
        <tbody>
          <% author.Books.forEach(book => { %>
            <tr>
              <td><%= book.title %></td>
              <td><%= book.genre %></td>
              <td><%= book.summary %></td>
              <td><%= book.release_date %></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <script></script>
</body>
</html>