<div class="container mt-4">
  <div class="card">
    <div class="card-body">
      <h2 class="card-title"><%= author.name %></h2>
      <p><strong>País:</strong> <%= author.country %></p>
      <p><strong>Fecha de nacimiento:</strong> <%= author.birthdate || 'N/A' %></p>
      <p><strong>Biografía:</strong> <%= author.bio || 'Sin biografía' %></p>

      <a href="/authors/<%= author.id %>/edit" class="btn btn-warning">Editar</a>
      <a href="/authors" class="btn btn-secondary">← Volver</a>
    </div>
  </div>

  <hr>

  <h3>Libros de <%= author.name %></h3>

  <% if (author.Books && author.Books.length > 0) { %>
    <table class="table table-striped table-hover">
      <thead class="table-dark">
        <tr>
          <th>Título</th>
          <th>Género</th>
          <th>Fecha de lanzamiento</th>
        </tr>
      </thead>
      <tbody>
        <% author.Books.forEach(book => { %>
          <tr>
            <td><a href="/books/<%= book.id %>"><%= book.title %></a></td>
            <td><%= book.genre || 'N/A' %></td>
            <td><%= book.release_date || 'N/A' %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } else { %>
    <div class="alert alert-info">No tiene libros registrados.</div>
  <% } %>
</div>
