<div class="container mt-5">
  <h1>New Author</h1>

  <form action="/authors" method="POST">

    <div class="mb-3">
      <label for="name" class="form-label">Name:</label>
      <input type="text" id="name" name="name" class="form-control" required>
    </div>

    <div class="mb-3">
      <label for="bio" class="form-label">Bio:</label>
      <textarea id="bio" name="bio" class="form-control" required></textarea>
    </div>

    <div class="mb-3">
      <label for="birthday" class="form-label">Date of Birth:</label>
      <select id="birthday" name="birthday" class="form-control" required>
        <% for (let year = 1900; year <= new Date().getFullYear(); year++) { %>
          <option value="<%= year %>"><%= year %></option>
        <% } %>
      </select>
    </div>

    <div class="mb-3">
      <label for="country" class="form-label">Country of Origin:</label>
      <input type="text" id="country" name="country" class="form-control" required>
    </div>

    <button type="submit">Create Author</button>
</div>