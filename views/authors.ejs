<!DOCTYPE html>
<html lang="en">
  <head>
      <meta charset="UTF-8">
      <meta name="viewport" content="width=device-width, initial-scale=1.0">
      <title><%= title %></title>
  </head>
  <body>
      <h1>Authors List</h1>
      <table class="table">
          <thead>
              <tr>
                  <th>Name</th>
                  <th>Number of Books</th>
                  <th>Average Score</th>
                  <th>Total Sales</th>
              </tr>
          </thead>
          <tbody>
              <% authors.forEach(author => { %>
                  <tr>
                      <td><a href="/authors/<%= author.id %>"><%= author.name %></a></td>
                      <td onclick="sortTable(1)"><%= author.total_books || 0 %></td>
                      <td onclick="sortTable(2)"><%= author.average_score || 0 %></td>
                      <td onclick="sortTable(3)"><%= author.total_sales || 0 %></td>
                  </tr>
              <% }); %>
          </tbody>
      </table>

      <script>
        function sortTable(columnIndex) {
          const table = document.querySelector('table');
          const rows = Array.from(table.rows).slice(1); // Exclude header row

          rows.sort((a, b) => {
              const aValue = parseFloat(a.cells[columnIndex].textContent) || 0;
              const bValue = parseFloat(b.cells[columnIndex].textContent) || 0;
              return aValue - bValue;
          });

          // Append sorted rows back to the table
          rows.forEach(row => table.appendChild(row));
        }
      </script>
  </body>
</html>